# ---------------------------------------------------------------------------
# hive-keeper environment. Copy to .env and fill in at launch. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- signer (required to send any transaction) ------------------------------
# The keeper's hot wallet. Holds only the transient ETH float mid-cycle; the SeatBuyer
# guarantees that float can only ever become an identity.md seat in the Safe vault.
# Read once at startup, never logged, never written anywhere.
KEEPER_PRIVATE_KEY=

# --- deployed contracts (set after each deploy) -----------------------------
HIVE_SPLITTER=            # HiveSplitter on Robinhood (the $HIVE creator-fee recipient); deploy pre-launch
HIVE_STAKING=            # HiveStaking on Robinhood; deploy post-launch (needs $HIVE + bridged IMD addrs)
SEAT_BUYER=              # SeatBuyer on Ethereum
SEAT_VAULT=              # the Safe on Ethereum that owns + runs the seats
SEAT_TREASURY=           # (optional) the Robinhood seat-treasury address; defaults to the keeper wallet
IMD_ROBINHOOD=           # bridged IMD token address on Robinhood Chain (set once the bridge route is known)

# --- well-known addresses (defaults are correct; override only if they change) ---
# PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# IDENTITY_MD=0x0000eC93127BAA929E58E97dd0095A2BFb38ec1D
# IMD=0xD34a99Bc0f67aE1bbd63C660e6d0b0dd03E263B7
# SEAPORT=0x0000000000000068F116a894984e2DB1123eB395

# --- API keys (both required for the buy + bridge lanes) --------------------
OPENSEA_API_KEY=         # https://docs.opensea.io  (listings + fulfillment data)
OPENSEA_COLLECTION=      # the identity.md OpenSea collection slug
RELAY_API_KEY=           # https://relay.link  (/quote is key-gated on some routes)

# --- RPC (defaults are public nodes; add your own for reliability) ----------
# ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network
# ETHEREUM_RPC_URLS=https://eth.llamarpc.com,https://ethereum-rpc.publicnode.com

# --- policy (safe defaults; tune to taste) ----------------------------------
# MIN_BRIDGE_ETH_WEI=400000000000000000     # 0.4 ETH: don't bridge dust
# GAS_RESERVE_WEI=10000000000000000         # 0.01 ETH kept on RH for gas
# MAX_SEAT_PRICE_WEI=2500000000000000000    # 2.5 ETH hard cap per seat (<= SeatBuyer.maxSeatPrice)
# MIN_REWARD_IMD_WEI=1000000000000000000    # 1 IMD: batch tiny rewards
# BRIDGE_SLIPPAGE_BPS=100                    # 1%
# POLL_MS=300000                            # 5 min loop
# GAS_MULT_BPS=13000                        # 1.3x gas estimate
